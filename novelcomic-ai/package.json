{
  "name": "novelcomic-ai", "version": "0.1.0", "private": true, "type": "module",
  "engines": { "node": "22.x" }, "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "concurrently -k -n api,worker -c blue,magenta \"pnpm --filter @novelcomic/api dev\" \"pnpm --filter @novelcomic/worker dev\"",
    "build": "pnpm -r build", "typecheck": "pnpm -r typecheck", "lint": "eslint .", "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0", "@types/node": "^24.5.2", "concurrently": "^9.2.1", "eslint": "^9.36.0",
    "prettier": "^3.6.2", "tsup": "^8.5.0", "tsx": "^4.20.5", "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1", "vitest": "^3.2.4"
  }
}
